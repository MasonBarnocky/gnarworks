# Copy this file to .env (same folder) and fill it in. Never commit .env.

# Reddit: https://www.reddit.com/prefs/apps -> "create another app" -> type "script"
# client id = the string under the app name; secret = "secret"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Optional: AI scoring + reply drafts (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# RADAR_MODEL=claude-sonnet-4-5

# Optional: send the top results to Telegram (reuse your Pi bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
